{
    "name": "Email Assistant Extensions",
    "description": "AI-Powered email assistant that helps you write emails faster and more effectively.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["storage", "activeTab"],
    "host_permissions": [
        "https://replymate-backend-k8uu.onrender.com/*",
        "*://mail.google.com/*"
    ],
    "content_scripts": [
        {
        "js": ["content.js"],
        "matches": ["*://mail.google.com/*"],
        "css" : ["content.css"],
        "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
        "resources": ["icons/*"],
        "matches": ["*://mail.google.com/*"]
        }
    ],
    "action": {
        "default_title": "Email Assistant"
    }
}